# openfga-provision-job.tmpl — per-Subscription Job that MERGES the AI Trust app's roles/permissions into
# the SHARED MESH OpenFGA, in a per-tenant store. Runs the app's own openfga-provision image
# (infra/openfga-provision, built from git) UNCHANGED — it is already parameterized by OPENFGA_URL +
# OPENFGA_STORE_NAME, so we just point it at the mesh OpenFGA instance with a tenant-scoped store name.
#
# What it does (idempotent): create/find store "ai-trust-<tenant>" in the mesh OpenFGA → write the app's
# authorization model (types user/role/platform, can_* relations, generated from constants.py) → seed the
# 6 built-in role→permission tuples → assign the tenant's bootstrap admin the platform_administrator role →
# write the store id to /config/store_id (the operator captures it into the Subscription status).
#
# Placeholders: __JOB_NAME__ __NS__ __TENANT_ID__ __STORE_NAME__ __ADMIN_USER__ __POOL_LABEL__
#               __PROVISION_IMAGE__ __OPENFGA_URL__
apiVersion: batch/v1
kind: Job
metadata:
  name: __JOB_NAME__
  namespace: __NS__
  labels: { app.kubernetes.io/managed-by: aitrust-mt-operator, tenant: "__TENANT_ID__" }
spec:
  backoffLimit: 6
  ttlSecondsAfterFinished: 600
  template:
    metadata:
      labels: { app: openfga-provision, tenant: "__TENANT_ID__" }
    spec:
      restartPolicy: OnFailure
      nodeSelector: { workload: __POOL_LABEL__ }
      tolerations: [{ key: workload, value: __POOL_LABEL__, effect: NoSchedule }]
      containers:
        - name: openfga-provision
          image: __PROVISION_IMAGE__
          imagePullPolicy: Always
          env:
            # point the app's provisioner at the MESH OpenFGA instance (shared), per-tenant store.
            - { name: OPENFGA_URL, value: "__OPENFGA_URL__" }
            - { name: OPENFGA_STORE_NAME, value: "__STORE_NAME__" }
            # seed this tenant's bootstrap admin as platform_administrator (the mesh account owner).
            - { name: INITIAL_ADMIN_USER, value: "__ADMIN_USER__" }
            # write the resolved store id where the operator can read it back for Subscription.status.
            - { name: OPENFGA_STORE_ID_FILE, value: "/config/store_id" }
          volumeMounts:
            - { name: fga-config, mountPath: /config }
      volumes:
        - { name: fga-config, emptyDir: {} }
