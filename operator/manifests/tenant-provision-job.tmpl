# tenant-provision-job.tmpl — a one-shot Job the operator stamps per Subscription to provision a TENANT
# in the SHARED AI Trust Platform MT app (it does NOT create an app copy). It runs the app's
# parameterized keycloak provisioner (infra/keycloak/provision.py) against the shared Keycloak to create
# a PER-TENANT realm whose tokens carry tenant_id=<account id>. Data isolation (tenant_id + RLS) then
# happens automatically as that tenant's users drive the shared backends.
#
# Placeholders (operator substitutes): __JOB_NAME__ __NS__ __TENANT_ID__ __REALM__ __DISPLAY__
# __APP_URL__ __POOL_LABEL__ __PROVISION_IMAGE__ __KC_URL__
apiVersion: batch/v1
kind: Job
metadata:
  name: __JOB_NAME__
  namespace: __NS__
  labels: { app.kubernetes.io/managed-by: aitrust-mt-operator, tenant: "__TENANT_ID__" }
spec:
  backoffLimit: 6
  ttlSecondsAfterFinished: 600
  template:
    metadata:
      labels: { app: tenant-provision, tenant: "__TENANT_ID__" }
    spec:
      restartPolicy: OnFailure
      nodeSelector: { workload: __POOL_LABEL__ }
      tolerations: [{ key: workload, value: __POOL_LABEL__, effect: NoSchedule }]
      containers:
        - name: provision
          image: __PROVISION_IMAGE__
          imagePullPolicy: Always
          env:
            - { name: KEYCLOAK_URL, value: "__KC_URL__" }
            # admin creds live in the shared app's app-secrets (there is no separate keycloak-admin secret).
            - { name: KEYCLOAK_ADMIN, valueFrom: { secretKeyRef: { name: app-secrets, key: KEYCLOAK_ADMIN } } }
            - { name: KEYCLOAK_ADMIN_PASSWORD, valueFrom: { secretKeyRef: { name: app-secrets, key: KEYCLOAK_ADMIN_PASSWORD } } }
            - { name: KEYCLOAK_CLIENT_SECRET, valueFrom: { secretKeyRef: { name: app-secrets, key: KEYCLOAK_CLIENT_SECRET } } }
            # per-tenant realm + tenant_id claim (the whole point):
            - { name: KC_REALM, value: "__REALM__" }
            - { name: TENANT_ID, value: "__TENANT_ID__" }
            - { name: KC_REALM_DISPLAY, value: "__DISPLAY__" }
            # the tenant's public app URL (used for the realm's oauth2-proxy client redirect URIs):
            - { name: APP_PUBLIC_URL, value: "__APP_URL__" }
            # a bootstrap admin user for the tenant realm (admin/password; change per deploy):
            - { name: APP_ADMIN_USERNAME, value: "admin" }
            - { name: APP_ADMIN_PASSWORD, value: "password" }
