spec:
  progressDeadlineSeconds: 600
  replicas: 1
  revisionHistoryLimit: 3
  selector:
    matchLabels:
      app: account-operator
  strategy:
    rollingUpdate:
      maxSurge: 25%
      maxUnavailable: 25%
    type: RollingUpdate
  template:
    metadata:
      annotations:
        kubectl.kubernetes.io/restartedAt: "2026-08-10T14:35:30+02:00"
      labels:
        app: account-operator
        control-plane: controller-manager
    spec:
      automountServiceAccountToken: true
      containers:
      - args:
        - operator
        - --leader-elect
        - --metrics-bind-address=:9090
        - --health-probe-bind-address=:8090
        - --log-level=debug
        - --no-json
        - --region=local
        - --environment=local
        - --image-tag=v0.15.4
        - --image-name="ghcr.io/platform-mesh/platform-mesh/account-operator"
        - --shutdown-timeout=1m
        - --max-concurrent-reconciles=10
        - --subroutines-workspace-type-enabled=true
        - --subroutines-workspace-enabled=true
        - --subroutines-workspace-ready-enabled=true
        - --subroutines-account-info-enabled=true
        - --controllers-account-info-enabled=true
        - --kcp-api-export-endpoint-slice-name=core.platform-mesh.io
        - --webhooks-enabled
        - --webhooks-cert-dir=/certs
        - --webhooks-deny-list=admin,root,system,www
        - --webhooks-additional-account-types=account
        env:
        - name: KUBECONFIG
          value: /api-kubeconfig/kubeconfig
        image: ghcr.io/platform-mesh/platform-mesh/account-operator:v0.15.4
        imagePullPolicy: IfNotPresent
        livenessProbe:
          failureThreshold: 1
          httpGet:
            path: /healthz
            port: 8090
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        name: account-operator
        ports:
        - containerPort: 9090
          name: metrics
          protocol: TCP
        - containerPort: 8090
          name: health-port
          protocol: TCP
        - containerPort: 9443
          name: webhook-port
          protocol: TCP
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /readyz
            port: 8090
            scheme: HTTP
          initialDelaySeconds: 5
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 40m
            memory: 50Mi
        securityContext:
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          seccompProfile:
            type: RuntimeDefault
        startupProbe:
          failureThreshold: 30
          httpGet:
            path: /readyz
            port: 8090
            scheme: HTTP
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        terminationMessagePath: /dev/termination-log
        terminationMessagePolicy: File
        volumeMounts:
        - mountPath: /api-kubeconfig
          name: external-api-server
        - mountPath: /certs
          name: cert
          readOnly: true
      dnsPolicy: ClusterFirst
      hostAliases:
      - hostnames:
        - localhost
        - ai-trust-1.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu
        - kcp.localhost
        - root.kcp.localhost
        - kcp.api.ai-trust-1.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu
        - nereus.kcp.localhost
        - triton.kcp.localhost
        ip: 100.104.188.4
      restartPolicy: Always
      schedulerName: default-scheduler
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      serviceAccount: account-operator
      serviceAccountName: account-operator
      terminationGracePeriodSeconds: 10
      volumes:
      - name: external-api-server
        secret:
