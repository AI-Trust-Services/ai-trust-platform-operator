############ account-operator deploy: args + env + volumes (CA source) ############
    cert-manager.io/inject-ca-from: platform-mesh-system/account-operator-serving-cert
    meta.helm.sh/release-name: account-operator
    helm.toolkit.fluxcd.io/name: account-operator
  name: account-operator
  replicas: 1
        - --leader-elect
        - --metrics-bind-address=:9090
        - --health-probe-bind-address=:8090
        - --log-level=debug
        - --no-json
        - --region=local
        - --environment=local
        - --image-tag=v0.15.4
        - --image-name="ghcr.io/platform-mesh/platform-mesh/account-operator"
        - --shutdown-timeout=1m
        - --max-concurrent-reconciles=10
        - --subroutines-workspace-type-enabled=true
        - --subroutines-workspace-enabled=true
        - --subroutines-workspace-ready-enabled=true
        - --subroutines-account-info-enabled=true
        - --controllers-account-info-enabled=true
        - --kcp-api-export-endpoint-slice-name=core.platform-mesh.io
        - --webhooks-enabled
        - --webhooks-cert-dir=/certs
        - --webhooks-deny-list=admin,root,system,www
        - --webhooks-additional-account-types=account
        - name: KUBECONFIG
          value: /api-kubeconfig/kubeconfig
        image: ghcr.io/platform-mesh/platform-mesh/account-operator:v0.15.4
        name: account-operator
          name: metrics
          name: health-port
          name: webhook-port
        - mountPath: /api-kubeconfig
          name: external-api-server
        - mountPath: /certs
          name: cert
        - localhost
        - kcp.localhost
        - root.kcp.localhost
        - nereus.kcp.localhost
        - triton.kcp.localhost
      schedulerName: default-scheduler
      serviceAccountName: account-operator
      - name: external-api-server
          secretName: account-operator-kubeconfig
      - name: cert
          secretName: account-operator-webhook-server-cert
  availableReplicas: 1
    reason: MinimumReplicasAvailable
    message: ReplicaSet "account-operator-585fb5c77b" has successfully progressed.
    reason: NewReplicaSetAvailable
  readyReplicas: 1
  replicas: 1
  updatedReplicas: 1

