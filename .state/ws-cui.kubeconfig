apiVersion: v1
kind: Config
current-context: c
clusters:
- name: w
  cluster:
    server: https://127.0.0.1:6443/clusters/root:providers:chat-ui
    insecure-skip-tls-verify: true
contexts:
- name: c
  context: { cluster: w, user: u }
users:
- name: u
  user:
    client-certificate-data: 
    client-key-data: 
