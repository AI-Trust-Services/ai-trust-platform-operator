ownerRefs= labels=
annos={"kubectl.kubernetes.io/last-applied-configuration":"{\"apiVersion\":\"v1\"
\"kind\":\"Secret\"
-- any cert-manager Certificate or gardener Certificate that WRITES domain-certificate-ca? --
NAME                                   SECRET
