apiVersion: v1
kind: Secret
metadata: { name: app-secrets, namespace: ai-trust-app }
stringData:
  # db-migrate + seeders connect as the OWNER (postgres); the runtime backends connect as the
  # NON-SUPERUSER app role so Postgres RLS is actually enforced (a superuser bypasses RLS → isolation
  # would be fake). See app-role.sql (run in pg-init).
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: postgres
  APP_DB_USER: ai_trust_app
  APP_DB_PASSWORD: apppw
  RABBITMQ_USER: guest
  RABBITMQ_PASSWORD: guest
  CLICKHOUSE_USER: default
  CLICKHOUSE_PASSWORD: ""
  MINIO_ROOT_USER: minioadmin
  MINIO_ROOT_PASSWORD: minioadmin
  KEYCLOAK_ADMIN: admin
  KEYCLOAK_ADMIN_PASSWORD: admin
  KEYCLOAK_CLIENT_SECRET: change-me-oauth2-proxy-secret
  USERS_BACKEND_CLIENT_SECRET: change-me-users-backend-secret
  APP_ADMIN_USERNAME: admin
  APP_ADMIN_PASSWORD: password
  OAUTH2_PROXY_COOKIE_SECRET: "__COOKIE_SECRET__"
  # Migrations run as owner:
  DATABASE_URL: postgresql+asyncpg://postgres:postgres@postgres:5432/ai_trust
  # Runtime backends use the RLS-bound app role:
  APP_DATABASE_URL: postgresql+asyncpg://ai_trust_app:apppw@postgres:5432/ai_trust
  RABBITMQ_URL: amqp://guest:guest@rabbitmq:5672/
---
apiVersion: v1
kind: ConfigMap
metadata: { name: app-config, namespace: ai-trust-app }
data:
  CLICKHOUSE_HOST: clickhouse
  CLICKHOUSE_PORT: "8123"
  ALLOWED_ORIGINS: "__APP_URL__"
  KEYCLOAK_REALM: ai-trust
  APP_PUBLIC_URL: "__APP_URL__"
  KEYCLOAK_PUBLIC_URL: "__APP_URL__/keycloak"
  MINIO_ENDPOINT: "minio:9000"
  MINIO_PUBLIC_ENDPOINT: "localhost:9000"
  MINIO_SECURE: "false"
  MINIO_REGION: "us-east-1"
  # MULTI-TENANCY: turn on shared-instance tenancy. Backends read the tenant_id claim from the
  # forwarded JWT (per-tenant Keycloak realm), set the tenant context, and Postgres RLS + ClickHouse/
  # MinIO scoping isolate data. Set to "single" to run this exact app single-tenant (backward-compat).
  TENANCY_MODE: "jwt"
  TENANT_CLAIM: "tenant_id"
  # jwt mode: users-backend manages per-tenant Keycloak realms, which live in the MESH keycloak
  # (NOT the app keycloak). Point it there. Single-tenant deploys omit this key → app keycloak.
  USERS_KEYCLOAK_URL: "http://keycloak-service.platform-mesh-system.svc.cluster.local:8080/keycloak"
  # Trusted issuer prefix — tenant JWTs are minted by the MESH Keycloak per-org realm
  # (<mesh-kc>/keycloak/realms/<org>); the app verifies iss starts with this and derives the JWKS
  # from the verified issuer. Required by libs/tenancy config.validate() when TENANCY_MODE=jwt.
  TENANCY_JWKS_ISSUER_BASE: "https://ai-trust-1.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu/keycloak/realms/"
