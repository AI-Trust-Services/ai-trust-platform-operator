apiVersion: v1
kind: Secret
metadata: { name: app-secrets, namespace: ai-trust-app }
stringData:
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: postgres
  RABBITMQ_USER: guest
  RABBITMQ_PASSWORD: guest
  CLICKHOUSE_USER: default
  CLICKHOUSE_PASSWORD: ""
  MINIO_ROOT_USER: minioadmin
  MINIO_ROOT_PASSWORD: minioadmin
  KEYCLOAK_ADMIN: admin
  KEYCLOAK_ADMIN_PASSWORD: admin
  KEYCLOAK_CLIENT_SECRET: change-me-oauth2-proxy-secret
  APP_ADMIN_USERNAME: admin
  APP_ADMIN_PASSWORD: password
  OAUTH2_PROXY_COOKIE_SECRET: "__COOKIE_SECRET__"
  DATABASE_URL: postgresql+asyncpg://postgres:postgres@postgres:5432/ai_trust
  RABBITMQ_URL: amqp://guest:guest@rabbitmq:5672/
---
apiVersion: v1
kind: ConfigMap
metadata: { name: app-config, namespace: ai-trust-app }
data:
  CLICKHOUSE_HOST: clickhouse
  CLICKHOUSE_PORT: "8123"
  ALLOWED_ORIGINS: "__APP_URL__"
  APP_PUBLIC_URL: "__APP_URL__"
  KEYCLOAK_PUBLIC_URL: "__APP_URL__/keycloak"
  MINIO_ENDPOINT: "minio:9000"
  MINIO_PUBLIC_ENDPOINT: "localhost:9000"
  MINIO_SECURE: "false"
  MINIO_REGION: "us-east-1"
