apiVersion: v1
kind: Secret
metadata: { name: app-secrets, namespace: ai-trust-app }
stringData:
  POSTGRES_USER: "CHANGE_ME"
  POSTGRES_PASSWORD: "CHANGE_ME"
  RABBITMQ_USER: "CHANGE_ME"
  RABBITMQ_PASSWORD: "CHANGE_ME"
  CLICKHOUSE_USER: "CHANGE_ME"
  CLICKHOUSE_PASSWORD: "CHANGE_ME"
  MINIO_ROOT_USER: "CHANGE_ME"
  MINIO_ROOT_PASSWORD: "CHANGE_ME"
  KEYCLOAK_ADMIN: "CHANGE_ME"
  KEYCLOAK_ADMIN_PASSWORD: "CHANGE_ME"
  KEYCLOAK_CLIENT_SECRET: "CHANGE_ME"
  USERS_BACKEND_CLIENT_SECRET: "CHANGE_ME"
  APP_ADMIN_USERNAME: "CHANGE_ME"
  APP_ADMIN_PASSWORD: "CHANGE_ME"
  OAUTH2_PROXY_COOKIE_SECRET: "CHANGE_ME"
  DATABASE_URL: "postgresql+asyncpg://CHANGE_ME:CHANGE_ME@postgres:5432/ai_trust"
  RABBITMQ_URL: "amqp://CHANGE_ME:CHANGE_ME@rabbitmq:5672/"
---
apiVersion: v1
kind: ConfigMap
metadata: { name: app-config, namespace: ai-trust-app }
data:
  CLICKHOUSE_HOST: clickhouse
  CLICKHOUSE_PORT: "8123"
  ALLOWED_ORIGINS: "__APP_URL__"
  KEYCLOAK_REALM: ai-trust
  APP_PUBLIC_URL: "__APP_URL__"
  KEYCLOAK_PUBLIC_URL: "__APP_URL__/keycloak"
  MINIO_ENDPOINT: "minio:9000"
  MINIO_PUBLIC_ENDPOINT: "localhost:9000"
  MINIO_SECURE: "false"
  MINIO_REGION: "us-east-1"
