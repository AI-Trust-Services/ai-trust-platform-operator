# HTTPRoute: __APP_DOMAIN__ -> oauth2-proxy (app entry) via the mesh gateway.
# Route lives in platform-mesh-system (next to the gateway); backend oauth2-proxy is in ai-trust-app,
# so a ReferenceGrant in ai-trust-app authorises the cross-namespace backendRef.
#
# A SECOND route sends /keycloak/* straight to Keycloak, BYPASSING oauth2-proxy (else oauth2-proxy
# gates the login page itself → infinite redirect loop). Keycloak is configured to serve natively
# under /keycloak (KC_HTTP_RELATIVE_PATH + KC_HOSTNAME=.../keycloak in step 3), so NO path rewrite here —
# all its form/asset URLs already carry the /keycloak prefix and stay on this bypass route.
# Gateway API matches the most-specific path, so /keycloak wins over /.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ai-trust-keycloak
  namespace: platform-mesh-system
spec:
  parentRefs:
    - name: k8sapi-gateway
      namespace: platform-mesh-system
      sectionName: terminate-aitrust
  hostnames:
    - __APP_DOMAIN__
  rules:
    - matches:
        - path: { type: PathPrefix, value: /keycloak }
      backendRefs:
        - group: ""
          kind: Service
          name: keycloak
          namespace: __APP_NS__
          port: 8080
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ai-trust-app
  namespace: platform-mesh-system
spec:
  parentRefs:
    - name: k8sapi-gateway
      namespace: platform-mesh-system
      sectionName: terminate-aitrust
  hostnames:
    - __APP_DOMAIN__
  rules:
    - backendRefs:
        - group: ""
          kind: Service
          name: oauth2-proxy
          namespace: __APP_NS__
          port: 8080
---
apiVersion: gateway.networking.k8s.io/v1beta1
kind: ReferenceGrant
metadata:
  name: allow-mesh-gateway-to-app
  namespace: __APP_NS__
spec:
  from:
    - group: gateway.networking.k8s.io
      kind: HTTPRoute
      namespace: platform-mesh-system
  to:
    - group: ""
      kind: Service
