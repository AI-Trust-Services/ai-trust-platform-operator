# ============================================================================
#  AI Trust Platform MARKET — deployment config (side-by-side provider on ai-trust-1)
# ============================================================================
# Publishes OUR marketplace branch of the AI Trust Platform as a SEPARATE Platform Mesh
# provider named "AI Trust Platform Market", with DISTINCT ids so it runs side-by-side with
# the existing MT "AI Trust Platform" provider (ns aitrust-msp / ws root:providers:ai-trust).
#
# To use: cp scripts/prerequisites/config.env.market scripts/prerequisites/config.env
# (or source this file). Then: bash scripts/prerequisites/login.sh && bash install.sh
#
# ⚠ TODO before deploy: confirm SHOOT/PROJECT/GARDENER_API and that GHCR push/pull creds exist.

# --- Payload cluster (Gardener shoot) ---------------------------------------
SHOOT_NAME="ai-trust-1"
PROJECT="garden-ai-trust"
GARDENER_API="https://api.garden.gardener.cc-one.showroom.apeirora.eu"

MESH_NS="platform-mesh-system"
GATEWAY_NS="platform-mesh-system"
GATEWAY_NAME="k8sapi-gateway"
KCP_INCLUSTER_URL="https://frontproxy-front-proxy.platform-mesh-system.svc.cluster.local:8443"

# --- Provider (kcp) — DISTINCT ids so it coexists with the existing ai-trust provider -------
PROVIDER_WS="root:providers:ai-trust-market"
EXPORT_NAME="sub.market.msp"
PROVIDER_DISPLAY_NAME="AI Trust Platform Market"

# --- Charts -----------------------------------------------------------------
AITRUST_APP_CHART="charts/aitrust-app"
AITRUST_PM_CHART="charts/aitrust-pm-app"
PROVIDER_NS="aitrust-market"

# --- Operator image (align tag with what step 2 builds; chart default is v22) ---------------
OPERATOR_IMAGE="ghcr.io/ai-trust-services/aitrust-operator"
OPERATOR_TAG="v22"

# --- App images — build from OUR marketplace branch, tag :market so it never clobbers :aitrust
REGISTRY="ghcr.io/ai-trust-services"
TAG="market"
APP_GIT_REF_DEFAULT="mircea-marketplace"

# --- Domain scheme (ai-trust-1 apex domain; wildcard rides the mesh gateway) ----------------
INSTANCE_DOMAIN_SUFFIX="ai-trust-1.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu"
SHARED_APP_HOST="ai-trust-market.ai-trust-1.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu"

# --- Portal content (in-cluster portal nginx in the market ns) ------------------------------
CONTENT_SCHEME="http"
AITRUST_CONTENT_HOST="aitrust-portal.aitrust-market.svc.cluster.local"

# --- Worker pool — DISTINCT pool so it doesn't share the ai-trust pool -----------------------
WORKER_TYPE="m_c16_m128_v2"
WORKER_POOL="ai-trust-market"
WORKER_ZONE="eu-de-1b"
WORKER_MIN="1"
WORKER_MAX="4"
MSP_WORKER_LABEL="ai-trust-market"

# --- Operations console (distinct; or skip this pass) ---------------------------------------
OPS_WORKER_TYPE="g_c2_m4_v2"
OPS_WORKER_POOL="market-ops"
OPS_WORKER_ZONE="eu-de-1b"
OPS_WORKER_MIN="1"
OPS_WORKER_MAX="2"
OPS_WORKER_LABEL="market-ops"
OPS_HOST="ai-trust-market-ops.ai-trust-1.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu"
OPS_PROVIDER_REALM="aitrust-market-provider"
OPS_CLIENT_ID="aitrust-market-ops"
OPS_ADMIN_USER="admin@aitrust-market-provider"
OPS_ADMIN_PASS="changeme-provider"
OPS_BACKEND_IMAGE="ghcr.io/ai-trust-services/aitrust-ops-backend:aitrust-mt"
OPS_CONSOLE_IMAGE="ghcr.io/ai-trust-services/aitrust-ops-console:aitrust-mt"

# --- Consumer (demo) --------------------------------------------------------
DEMO_USER="tutorial@example.com"
ORG_NAME="aitrustmarket"
ACCOUNT_NAME="tenant"
INSTANCE_NAME="market-subscription"
