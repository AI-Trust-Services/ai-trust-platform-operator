# ============================================================================
#  AI Trust Platform MSP provider — deployment config EXAMPLE
#
#  Copy to config.env and fill in values for your Gardener shoot:
#    cp scripts/prerequisites/config.env.example scripts/prerequisites/config.env
#
#  Values below are from the ai-trust-1 reference deploy — replace with your
#  shoot's coordinates. Required fields are marked with "# REQUIRED".
# ============================================================================

# --- Payload cluster (Gardener shoot) ---------------------------------------
SHOOT_NAME="ai-trust-1"            # REQUIRED — Gardener shoot name
PROJECT="garden-ai-trust"          # REQUIRED — Gardener project namespace
GARDENER_API="https://api.garden.gardener.cc-one.showroom.apeirora.eu"  # REQUIRED

MESH_NS="platform-mesh-system"
GATEWAY_NS="platform-mesh-system"
GATEWAY_NAME="k8sapi-gateway"

# Frontproxy (kcp) in-cluster endpoint the syncagent talks to. MUST be :8443.
KCP_INCLUSTER_URL="https://frontproxy-front-proxy.platform-mesh-system.svc.cluster.local:8443"

# --- Provider (kcp) ---------------------------------------------------------
PROVIDER_WS="root:providers:ai-trust"
EXPORT_NAME="sub.aitrust.msp"

# --- Charts (local paths in this bundle) ------------------------------------
AITRUST_APP_CHART="charts/aitrust-app"
AITRUST_PM_CHART="charts/aitrust-pm-app"
PROVIDER_NS="aitrust-msp"

# --- Operator image ---------------------------------------------------------
OPERATOR_IMAGE="ghcr.io/ai-trust-services/aitrust-operator"
OPERATOR_TAG="v21"                  # must match the tag built by 2-build-operator-image.sh

# --- App images -------------------------------------------------------------
REGISTRY="ghcr.io/ai-trust-services"
TAG="aitrust"
APP_GIT_REF_DEFAULT="main"          # branch/tag of ai-trust-platform to build in step 2b

# --- Domain scheme ----------------------------------------------------------
# Pattern: <shoot>.<project-short>.<gardener-domain>
INSTANCE_DOMAIN_SUFFIX="ai-trust-1.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu"  # REQUIRED
SHARED_APP_HOST="shared.ai-trust-1.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu"  # REQUIRED

# --- Portal content ---------------------------------------------------------
CONTENT_SCHEME="http"
AITRUST_CONTENT_HOST="aitrust-portal.aitrust-msp.svc.cluster.local"

# --- Worker pool ------------------------------------------------------------
WORKER_TYPE="m_c16_m128_v2"
WORKER_POOL="ai-trust"
WORKER_ZONE="eu-de-1b"
WORKER_MIN="1"
WORKER_MAX="4"
MSP_WORKER_LABEL="ai-trust"

# --- Operations console -----------------------------------------------------
OPS_WORKER_TYPE="g_c2_m4_v2"
OPS_WORKER_POOL="ops"
OPS_WORKER_ZONE="eu-de-1b"
OPS_WORKER_MIN="1"
OPS_WORKER_MAX="2"
OPS_WORKER_LABEL="ops"
OPS_HOST="ops.ai-trust-1.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu"  # REQUIRED
OPS_PROVIDER_REALM="aitrust-provider"
OPS_CLIENT_ID="aitrust-ops"
OPS_ADMIN_USER="admin@aitrust-provider"
OPS_ADMIN_PASS="changeme-provider"
OPS_BACKEND_IMAGE="ghcr.io/ai-trust-services/aitrust-ops-backend:aitrust-mt"
OPS_CONSOLE_IMAGE="ghcr.io/ai-trust-services/aitrust-ops-console:aitrust-mt"

# --- Consumer (demo) --------------------------------------------------------
DEMO_USER="tutorial@example.com"
ORG_NAME="aitrust"
ACCOUNT_NAME="tenant"
INSTANCE_NAME="my-subscription"
