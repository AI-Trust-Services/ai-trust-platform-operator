# ============================================================================
#  AI Trust Platform MSP provider — deployment config
# ============================================================================
# Publishes the AI Trust app as a Platform Mesh provider in shared mode: ONE shared app
# runs on the payload cluster; a customer clicks Enable on the central cluster (marketplace/portal)
# and creates a SUBSCRIPTION; the operator provisions a TENANT inside the shared app
# (per-tenant Keycloak realm + isolated Postgres schema, ClickHouse DB, MinIO bucket).

# --- Payload cluster (Gardener shoot) ---------------------------------------
SHOOT_NAME=""              # payload cluster shoot name — required, must be set
PROJECT=""                 # Gardener project namespace (e.g. garden-<project>)
GARDENER_API=""            # Gardener API server URL

MESH_NS="platform-mesh-system"
GATEWAY_NS="platform-mesh-system"
GATEWAY_NAME="k8sapi-gateway"

# Frontproxy (kcp) in-cluster endpoint the syncagent talks to. MUST be :8443.
KCP_INCLUSTER_URL="https://frontproxy-front-proxy.platform-mesh-system.svc.cluster.local:8443"

# --- Provider (kcp) ---------------------------------------------------------
PROVIDER_WS="root:providers:ai-trust"
EXPORT_NAME="sub.aitrust.msp"

# --- Charts (local paths in this bundle) ------------------------------------
AITRUST_APP_CHART="charts/aitrust-app"
AITRUST_PM_CHART="charts/aitrust-pm-app"
PROVIDER_NS="aitrust-msp"

# --- Operator image ---------------------------------------------------------
OPERATOR_IMAGE="ghcr.io/ai-trust-services/aitrust-operator"
OPERATOR_TAG="v21"

# --- App images -------------------------------------------------------------
REGISTRY="ghcr.io/ai-trust-services"
TAG="aitrust"
APP_GIT_REF_DEFAULT="main"

# --- Domain scheme ----------------------------------------------------------
INSTANCE_DOMAIN_SUFFIX=""   # per-org domain suffix (e.g. <shoot>.<project>.<gardener-domain>)
SHARED_APP_HOST=""          # shared app hostname

# --- Portal content ---------------------------------------------------------
CONTENT_SCHEME="http"
AITRUST_CONTENT_HOST="aitrust-portal.aitrust-msp.svc.cluster.local"

# --- Worker pool ------------------------------------------------------------
WORKER_TYPE="m_c16_m128_v2"
WORKER_POOL="ai-trust"
WORKER_ZONE="eu-de-1b"
WORKER_MIN="1"
WORKER_MAX="4"
MSP_WORKER_LABEL="ai-trust"

# --- Operations console -----------------------------------------------------
OPS_WORKER_TYPE="g_c2_m4_v2"
OPS_WORKER_POOL="ops"
OPS_WORKER_ZONE="eu-de-1b"
OPS_WORKER_MIN="1"
OPS_WORKER_MAX="2"
OPS_WORKER_LABEL="ops"
OPS_HOST=""                 # ops console hostname
OPS_PROVIDER_REALM="aitrust-provider"
OPS_CLIENT_ID="aitrust-ops"
OPS_ADMIN_USER="admin@aitrust-provider"
OPS_ADMIN_PASS="changeme-provider"
OPS_BACKEND_IMAGE="ghcr.io/ai-trust-services/aitrust-ops-backend:aitrust-mt"
OPS_CONSOLE_IMAGE="ghcr.io/ai-trust-services/aitrust-ops-console:aitrust-mt"

# --- Consumer (demo) --------------------------------------------------------
DEMO_USER="tutorial@example.com"
ORG_NAME="aitrust"
ACCOUNT_NAME="tenant"
INSTANCE_NAME="my-subscription"
