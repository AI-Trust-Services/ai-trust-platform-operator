# ============================================================================
#  AI Trust Platform MT (multi-tenant) as an MSP provider on ai-trust-1 — config
# ============================================================================
# Publishes the AI Trust app as a Platform Mesh provider in SHARED MULTI-TENANT mode: ONE shared app
# runs on the shoot; a customer clicks Enable and creates a SUBSCRIPTION, and the operator provisions a
# TENANT inside the shared app (per-tenant Keycloak realm + tenant_id data isolation via RLS) — it does
# NOT stamp a new app copy. Uses the MT app images (TENANCY_MODE=jwt). Fully isolated from the existing
# Standard_AiTrust_MSP (full-copy) provider: different API group, workspace, namespace, worker pool.

SHOOT_NAME="ai-trust-1"            # the mesh shoot (NOT ccep6xjste)
PROJECT="garden-ai-trust"
GARDENER_API="https://api.garden.gardener.cc-one.showroom.apeirora.eu"
MESH_NS="platform-mesh-system"
GATEWAY_NS="platform-mesh-system"
GATEWAY_NAME="k8sapi-gateway"

# Frontproxy (kcp) in-cluster endpoint the syncagent talks to. MUST be :8443.
KCP_INCLUSTER_URL="https://frontproxy-front-proxy.platform-mesh-system.svc.cluster.local:8443"

# --- Provider (kcp) — DISTINCT from Standard_AiTrust_MSP so the two providers never collide --------
PROVIDER_WS="root:providers:ai-trust-mt"
# API group MUST be hyphen-free (portal GraphQL) — mirrors the showroom hyphen-free groups.
EXPORT_NAME="sub.aitrustmt.msp"

# --- Charts (local paths in this bundle) ------------------------------------
AITRUST_APP_CHART="charts/aitrust-mt-app"      # workload side (operator + syncagent + portal nginx + shared app)
AITRUST_PM_CHART="charts/aitrust-mt-pm-app"    # kcp side (APIExport + CC + ProviderMetadata + RBAC)
PROVIDER_NS="aitrust-mt-msp"                    # namespace on the shoot for operator/syncagent/nginx + shared app

# --- Operator image (subscription operator — provisions a tenant in the shared app) -----------------
OPERATOR_IMAGE="mirceacraciun795/aitrust-mt-operator"
OPERATOR_TAG="v5"

# --- MT app images (rebuilt from the Stage-A multi-tenant code; tag distinct from the single-tenant :aitrust-1) ---
REGISTRY="mirceacraciun795"
TAG="aitrust-mt"

# --- Domain scheme ----------------------------------------------------------
# ONE shared app host + per-tenant subdomains that route to it (tenant resolved from its Keycloak realm claim).
INSTANCE_DOMAIN_SUFFIX="ai-trust-1.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu"
SHARED_APP_HOST="ai-trust-mt.ai-trust-1.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu"

# --- Portal content (marketplace tile) --------------------------------------
CONTENT_SCHEME="http"
AITRUST_CONTENT_HOST="aitrust-mt-portal.aitrust-mt-msp.svc.cluster.local"

# --- Dedicated worker pool — SEPARATE from msp-at-big; the MT deployment never shares nodes ---------
WORKER_TYPE="m_c16_m128_v2"        # 16 vCPU / 128Gi
WORKER_POOL="ai-trust-mt"          # Gardener pool name (<=15 bytes: 11) — the user-requested new worker
WORKER_ZONE="eu-de-1b"
WORKER_MIN="1"
WORKER_MAX="4"
MSP_WORKER_LABEL="ai-trust-mt"     # node label + pod nodeSelector the shared app + operator pin to

# --- Consumer (demo) --------------------------------------------------------
DEMO_USER="tutorial@example.com"   # must look like an email (org initializer validates format)
ORG_NAME="aitrustmt"               # org Account
ACCOUNT_NAME="tenant"              # child Account (the Subscription CR lands here)
INSTANCE_NAME="my-subscription"    # the Subscription name step 6 creates
