# ============================================================================
#  AI Trust Platform as an MSP provider on ai-trust-1 — config
# ============================================================================
# Publishes the AI Trust app (Standard_Ai_Platform) as a Platform Mesh provider: a customer clicks
# Enable in the portal and the operator stamps a FULL isolated app copy (all ~23 services + dedicated
# postgres/clickhouse/minio/rabbitmq/keycloak) into a fresh namespace. No app code changes.

SHOOT_NAME="ai-trust-1"            # the mesh shoot (NOT ccep6xjste)
PROJECT="garden-ai-trust"
GARDENER_API="https://api.garden.gardener.cc-one.showroom.apeirora.eu"
MESH_NS="platform-mesh-system"
GATEWAY_NS="platform-mesh-system"
GATEWAY_NAME="k8sapi-gateway"

# Frontproxy (kcp) in-cluster endpoint the syncagent talks to. MUST be :8443 (chart default :6443 wrong here).
KCP_INCLUSTER_URL="https://frontproxy-front-proxy.platform-mesh-system.svc.cluster.local:8443"

# --- Provider (kcp) ---------------------------------------------------------
PROVIDER_WS="root:providers:ai-trust"
EXPORT_NAME="trust.aitrust.msp"

# --- Charts (local paths in this bundle) ------------------------------------
AITRUST_APP_CHART="charts/aitrust-msp-app"     # workload side (operator + syncagent + portal nginx)
AITRUST_PM_CHART="charts/aitrust-pm-app"       # kcp side (APIExport + CC + ProviderMetadata + RBAC)
PROVIDER_NS="aitrust-msp"                       # namespace on the shoot for the operator/syncagent/nginx

# --- Operator image ---------------------------------------------------------
OPERATOR_IMAGE="mirceacraciun795/aitrust-msp-operator"
OPERATOR_TAG="v7"

# --- App images (REUSED, already pushed by Standard_Ai_Platform — no rebuild) ---
REGISTRY="mirceacraciun795"
TAG="aitrust-1"

# --- Per-instance URL scheme ------------------------------------------------
# Each instance is reachable at https://<instance>.<INSTANCE_DOMAIN_SUFFIX> under the mesh wildcard
# listener + cert. The operator creates one HTTPRoute per instance.
INSTANCE_DOMAIN_SUFFIX="ai-trust-1.ai-trust.shoot.gardener.cc-one.showroom.apeirora.eu"

# --- Portal content (marketplace tile) --------------------------------------
CONTENT_SCHEME="http"
AITRUST_CONTENT_HOST="aitrust-portal.aitrust-msp.svc.cluster.local"

# --- Dedicated worker pool (each Enable ≈ one node: ~8-10Gi RAM per instance) ---
WORKER_TYPE="m_c16_m128_v2"        # 16 vCPU / 128Gi — a full instance fits comfortably (no pressure cascade)
WORKER_POOL="msp-at-big"           # Gardener pool names max 15 bytes
WORKER_ZONE="eu-de-1b"
WORKER_MIN="1"
WORKER_MAX="4"
MSP_WORKER_LABEL="msp-aitrust"     # node label + pod nodeSelector the operator pins instances to

# --- Consumer (demo) --------------------------------------------------------
DEMO_USER="tutorial@example.com"   # must look like an email (org initializer validates format)
ORG_NAME="aitrustdemo"             # org Account
ACCOUNT_NAME="tenant"              # child Account (the instance CR lands here)
INSTANCE_NAME="my-aitrust"         # the AITrustPlatformInstance name step 6 creates
INSTANCE_SIZE="standard"
